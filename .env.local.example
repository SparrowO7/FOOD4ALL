# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key used for admin/cron tasks (NEVER expose to the browser).
# Optional for the MVP — only needed for the freshness-expiry job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
